<?xml version="1.0" encoding="utf-8" ?>

<!--Use class for instances.-->
<ResourceDictionary
    x:Class="RCS.PortableShop.Common.Styles.Themes.DarkTheme"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--TODO Improve colour-selection.-->

    <!-- Colours
    https://learn.microsoft.com/en-us/dotnet/api/system.windows.media.colors
    -->
  
    <Color x:Key="MessageColour">#87CEFA</Color> <!-- LightSkyBlue -->
  
    <Color x:Key="AssertColour">#90EE90</Color> <!-- LightGreen -->
    <Color x:Key="WarningColour">#FFD700</Color> <!-- Gold -->
    <Color x:Key="ErrorColour">#FF6B6B</Color> <!-- Soft Red -->

    <Color x:Key="SettingsBackgroundColour">DarkKhaki</Color>
    <Color x:Key="ResultsBackgroundColour">#121212</Color> <!-- Near black -->
    <Color x:Key="InvalidBackgroundColour">#5A1F1F</Color>

    <Color x:Key="ProductsLevel0Colour">#2A6F97</Color>
    <Color x:Key="ProductsLevel1Colour">#1E3A5F</Color>
  
    <Color x:Key="CartLevel0Colour">#3D3D00</Color>
    <Color x:Key="CartLevel1Colour">#2E2E1A</Color>
  
    <Color x:Key="LabelTextColour">#E0E0E0</Color>
    <Color x:Key="ValueTextColour">#FFFFFF</Color>

</ResourceDictionary>