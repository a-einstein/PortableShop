<?xml version="1.0" encoding="utf-8" ?>

<!--Use class for instances.-->
<ResourceDictionary
    x:Class="RCS.PortableShop.Common.Styles.Themes.LightTheme"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

  <!-- Named colours
  https://www.w3schools.com/colors/default.asp
  https://learn.microsoft.com/en-us/dotnet/api/system.windows.media.colors
  -->
  
  <Color x:Key="MessageColour">DarkBlue</Color>

  <Color x:Key="AssertColour">Green</Color>
  <Color x:Key="WarningColour">Orange</Color>
  <Color x:Key="ErrorColour">Red</Color>

    <Color x:Key="SettingsBackgroundColour">LightSlateGray</Color>
  <Color x:Key="ResultsBackgroundColour">White</Color>

  <Color x:Key="WarningBackgroundColour">Orange</Color>
  <Color x:Key="InvalidBackgroundColour">LightCoral</Color>

  <Color x:Key="ProductsLevel0Colour">DodgerBlue</Color>
  <Color x:Key="ProductsLevel1Colour">LightSkyBlue</Color>

  <Color x:Key="CartLevel0Colour">Yellow</Color>
  <Color x:Key="CartLevel1Colour">LemonChiffon</Color>

  <Color x:Key="LabelTextColour">DarkSlateGray</Color>
  <Color x:Key="ValueTextColour">MidnightBlue</Color>
  <!--DarkBlue-->

</ResourceDictionary>